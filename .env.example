# Токен нейрошлюза ai.rt.ru (Bearer JWT)
AI_API_KEY=your-api-key-here

# Базовый URL API (без слэша в конце)
AI_BASE_URL=https://ai.rt.ru/api/1.0

# Модель Leopold/Qwen
AI_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct-FP8

# Эндпоинт чата (см. api_нейрошлюз.ipynb → llama_chat)
AI_CHAT_PATH=/lleopold/chatMulti

# Лимит токенов ответа
AI_MAX_TOKENS=4096

# Path to seed initiatives registry (relative to project root).
# Uploads from UI are stored in data/registry-current.xlsx and take priority.
REGISTRY_PATH=ai-initiatives-2026-08-21.xlsx

# Таймаут запроса к нейрошлюзу (мс) и число попыток при битом JSON / таймауте
AI_TIMEOUT_MS=90000
AI_JSON_RETRIES=2
